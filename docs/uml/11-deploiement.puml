@startuml
title Diagramme de déploiement
skinparam backgroundColor #F8F1EC
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName Arial
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #754735
  ArrowColor #754735
  FontColor #2B211E
}
node "Téléphone du serveur\n<<mobile>>" as PhoneServer #E4C7BD {
  artifact "Application mobile" as AppS
}
node "Téléphone / tablette\ndu manager\n<<mobile>>" as PhoneManager #E4C7BD {
  artifact "Application mobile" as AppM
}
cloud "Internet sécurisé\nHTTPS" as Internet #F1DDD4
node "Environnement SaaS" as Cloud {
  node "Service applicatif" as Service {
    artifact "API REST"
    artifact "Service d'authentification"
    artifact "Service de reporting"
  }
  database "Base de données" as DB
  node "Stockage média" as Media
}
AppS --> Internet
AppM --> Internet
Internet --> Service : TLS/HTTPS
Service --> DB : accès chiffré
Service --> Media : images produits
@enduml
